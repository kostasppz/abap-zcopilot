# Public DNS name that points to the GPU VM. Do not include https:// or a path.
GUARDIAN_DOMAIN=guardian.example.com

# Browser chat hostname. It is protected separately with Caddy Basic Auth.
CHAT_DOMAIN=assistant.example.com

# Absolute path of the existing ABAP Expert project on the VM. It must contain
# agent.py, Dockerfile, requirements, Modelfile, knowledge/, templates/ and static/.
ABAP_AGENT_DIR=/opt/abap-stack/abap-agent

# Names must match the models created by the ABAP Expert Modelfile/Ollama.
CHAT_MODEL=abap-expert
EMBEDDING_MODEL=embeddinggemma

# Public API safeguards.
RATE_LIMIT_PER_MINUTE=60
MAX_SOURCE_LENGTH=200000
MAX_REQUEST_BODY_BYTES=1048576
REQUEST_TIMEOUT_SECONDS=180
AI_TIMEOUT_SECONDS=180
