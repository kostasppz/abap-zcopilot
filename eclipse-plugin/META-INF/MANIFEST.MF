Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: ABAP Guardian
Bundle-SymbolicName: com.abapguardian.eclipse.plugin;singleton:=true
Bundle-Version: 0.1.0.qualifier
Bundle-Activator: com.abapguardian.eclipse.Activator
Bundle-Vendor: ABAP Guardian Project
Bundle-RequiredExecutionEnvironment: JavaSE-21
Bundle-ActivationPolicy: lazy
Require-Bundle: org.eclipse.core.runtime,
 org.eclipse.core.resources,
 org.eclipse.ui,
 org.eclipse.ui.editors,
 org.eclipse.ui.workbench.texteditor,
 org.eclipse.jface.text,
 org.eclipse.compare,
 org.eclipse.equinox.security,
 org.eclipse.core.jobs
Import-Package: org.osgi.framework
Export-Package: com.abapguardian.eclipse.api
Automatic-Module-Name: com.abapguardian.eclipse.plugin
